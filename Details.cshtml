@model BanAn
@{ ViewData["Title"] = "Chi tiết bàn ăn"; }
<h3 class="section-title">Chi tiết bàn ăn</h3>
<div class="card p-4 col-lg-7">
    <dl class="row mb-0">
        <dt class="col-sm-3">Tên bàn</dt><dd class="col-sm-9">@Model.TenBan</dd>
        <dt class="col-sm-3">Loại bàn</dt><dd class="col-sm-9">@Model.LoaiBan?.TenLoaiBan</dd>
        <dt class="col-sm-3">Số chỗ ngồi</dt><dd class="col-sm-9">@Model.SoChoNgoi</dd>
        <dt class="col-sm-3">Vị trí</dt><dd class="col-sm-9">@Model.ViTri</dd>
        <dt class="col-sm-3">Mô tả</dt><dd class="col-sm-9">@Model.MoTa</dd>
        <dt class="col-sm-3">Trạng thái</dt><dd class="col-sm-9">@Model.TrangThai</dd>
    </dl>
</div>
<div class="mt-3 d-flex gap-2">
    <a asp-action="Index" class="btn btn-outline-dark"><i class="bi bi-arrow-left me-1"></i>Quay lại</a>
    @if (Context.Session.GetInt32(SessionKeys.MaTaiKhoan) != null && Context.Session.GetString(SessionKeys.VaiTro) != VaiTro.Admin.ToString() && Model.TrangThai == TrangThaiBan.SanSang)
    {
        <a class="btn btn-gold" asp-controller="PhieuDatBan" asp-action="Create" asp-route-maBan="@Model.MaBan"><i class="bi bi-calendar-plus me-1"></i>Đặt bàn này</a>
    }
</div>
