@model BanAn
@{ ViewData["Title"] = "Xóa bàn ăn"; }
<h3 class="section-title text-danger">Xóa bàn ăn</h3>
<div class="card p-4 col-lg-7">
    @if (ViewBag.ConLienKet == true)
    {
        <div class="alert alert-danger"><i class="bi bi-exclamation-triangle-fill me-1"></i>Không thể xóa: bàn đã có phiếu đặt liên quan.</div>
    }
    <p>Bạn có chắc chắn muốn xóa bàn <b>@Model.TenBan</b> không?</p>
    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="MaBan" />
        <button type="submit" class="btn btn-danger" @(ViewBag.ConLienKet == true ? "disabled" : "")><i class="bi bi-trash me-1"></i>Xác nhận xóa</button>
        <a asp-action="Index" class="btn btn-outline-dark">Hủy</a>
    </form>
</div>
